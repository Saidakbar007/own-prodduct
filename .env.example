# Секретный ключ для подписи cookie-сессий (придумай свою случайную строку)
SECRET_KEY=change-me-to-a-random-secret-string

# Ключ для Claude API (для AI-коуча). Можно оставить пустым — тогда коуч работает на заглушках.
ANTHROPIC_API_KEY=

# Логины, у которых есть доступ к /admin (через запятую, без пробелов вокруг запятой не обязательно).
# Остальным пользователям /admin отвечает 404. Пример: ADMIN_LOGINS=demo,admin2
ADMIN_LOGINS=
