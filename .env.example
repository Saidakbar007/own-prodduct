# Секретный ключ для подписи cookie-сессий (придумай свою случайную строку)
SECRET_KEY=change-me-to-a-random-secret-string

# Адрес базы данных. Пусто/не задано — локальный SQLite (app.db), для разработки
# и тестов этого достаточно. На Render/Neon сюда подставляется PostgreSQL URL
# (схему postgres:// приложение само приводит к нужному драйверу).
DATABASE_URL=

# Ключ для Claude API — понадобится в Фазе 4 для генерации сезона под "свою цель".
# Можно оставить пустым — тогда доступна только библиотека готовых шаблонов.
ANTHROPIC_API_KEY=
